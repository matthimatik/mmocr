    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train ABCNet on TRUDI",
            "type": "debugpy",
            "request": "launch",
            "module": "mim",
            "args": [
                "train",
                "mmocr",
                "config/abcnet/abcnet_resnet50_fpn_500e_trudi_24gbRAM.py",
                // "config/abcnet/abcnet_resnet50_fpn_500e_icdar2015_24gbRAM.py",
                "--work-dir",
                "work_dirs/",
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/projects/ABCNet"
            },
            "cwd": "${workspaceFolder}/projects/ABCNet",
        },
    ]
}